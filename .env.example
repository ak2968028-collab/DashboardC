# Copy to .env to override the defaults used by docker-compose.yml
POSTGRES_DB=varanasi
POSTGRES_USER=varanasi
POSTGRES_PASSWORD=change-me
WEB_PORT=3000
API_PORT=8000
DB_PORT=5432
GEOSERVER_PORT=8080
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change-me

# Public domain served through the Cloudflare tunnel (no scheme), e.g. carbon.example.com
PUBLIC_DOMAIN=carbon.example.com
# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel
CLOUDFLARE_TUNNEL_TOKEN=
# Internal addresses the Next.js server proxies /api/* and /geoserver/* to
FRONTEND_API_URL=http://fast_backend:8000
FRONTEND_GEOSERVER_URL=http://geoserver:8080
